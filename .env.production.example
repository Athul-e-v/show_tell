# Application environment
APP_ENV=production
APP_NAME=HAT Converse API
LOG_LEVEL=INFO

# PostgreSQL container configuration
POSTGRES_USER=hatconverse
POSTGRES_PASSWORD=REPLACE_WITH_STRONG_DATABASE_PASSWORD
POSTGRES_DB=hatconverse

# Shared database connection for API and document service
DATABASE_URL=postgresql+psycopg://hatconverse:REPLACE_WITH_STRONG_DATABASE_PASSWORD@db:5432/hatconverse

# Document service internal API key
DOCUMENT_API_KEY=REPLACE_WITH_LONG_RANDOM_SERVICE_API_KEY

# Authentication configuration
# We will address authentication separately, as requested.
SECRET_KEY=REPLACE_WITH_RANDOM_SECRET
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Replace with your actual production domain before deployment
CORS_ORIGINS=["https://your-domain.example"]
